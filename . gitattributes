# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Explicitly enforce LF on source and manuscript formats
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.webp binary
*.storyvault binary
*.db binary